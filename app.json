{
  "expo": {
    "name": "ev-charging-map",
    "slug": "ev-charging-map",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "evchargingmap",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ch.woldri.evchargingmap",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "This app needs access to your location to display it on the map.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "EV Charging"
      },
      "config": {}
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#059669"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.krystofwoldrich.evchargingmap",
      "config": {}
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "./plugins/withPlainLaunchScreen",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-maps",
        {
          "requestLocationPermission": true,
          "locationPermission": "Allow EV Charging Map to use your location"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to show your position on the map."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "5f4b89ff-9896-4011-9124-cc04ff42ad73"
      }
    },
    "owner": "krystofwoldrich",
    "runtimeVersion": "1.1.1",
    "updates": {
      "url": "https://u.expo.dev/5f4b89ff-9896-4011-9124-cc04ff42ad73",
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
