{
  "cli": {
    "version": ">= 25.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "env": { "APP_VARIANT": "development" },
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "image": "sdk-58"
      },
      "autoIncrement": true,
      "channel": "development"
    },
    "preview": {
      "environment": "preview",
      "env": { "APP_VARIANT": "production" },
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "environment": "production",
      "env": { "APP_VARIANT": "production" },
      "autoIncrement": true,
      "ios": {
        "image": "sdk-58"
      },
      "channel": "production"
    },
    "simulator": {
      "extends": "production",
      "autoIncrement": false,
      "ios": {
        "simulator": true,
        "image": "sdk-58"
      }
    },
    "development-simulator": {
      "extends": "development",
      "autoIncrement": false,
      "ios": {
        "simulator": true,
        "image": "sdk-58"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6749909889"
      }
    }
  }
}
