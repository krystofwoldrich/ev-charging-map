    "fix": "expo lint --fix",
    "prebuild": "APP_VARIANT=development expo prebuild",
    "prebuild:clean": "APP_VARIANT=development expo prebuild --clean",
    "prebuild:production": "APP_VARIANT=production expo prebuild --clean",
    "export": "expo export",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check:api": "tsx scripts/check-api.ts"
  },
  "dependencies": {
