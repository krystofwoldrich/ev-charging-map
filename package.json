{
  "name": "ev-charging-map",
  "main": "expo-router/entry",
  "version": "1.1.1",
  "scripts": {
    "pod-install": "npx pod-install",
    "start": "APP_VARIANT=development expo start --dev-client --scheme evchargingmap-dev",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "APP_VARIANT=development expo run:android",
    "ios": "APP_VARIANT=development expo run:ios",
